{
  "name": "testnova",
  "private": true,
  "type": "module",
  "description": "TestNova: AI-driven web application testing with Playwright Test.",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:list": "playwright test --list --reporter=json",
    "test:gate": "playwright test --grep-invert \"@known-defect|@live\"",
    "test:known-defects": "playwright test --grep \"@known-defect\"",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit -p scaffold/tsconfig.json",
    "browsers": "playwright install chromium firefox webkit",
    "dashboard:install": "npm --prefix dashboard/web install",
    "dashboard": "node dashboard/scripts/dev.mjs",
    "supabase:sync": "node dashboard/scripts/supabase-sync.mjs",
    "qa-report": "node dashboard/scripts/qa-report.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "exceljs": "^4.4.0",
    "localtunnel": "^2.0.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@supabase/supabase-js": "^2.118.0",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0"
  }
}
