# Copy to .env (never commit .env). The Setup screen writes these for you.
# Default role
TEST_USERNAME=
TEST_PASSWORD=
# Extra roles: TEST_<ROLE>_USERNAME / TEST_<ROLE>_PASSWORD, e.g.
# TEST_ADMIN_USERNAME=
# TEST_ADMIN_PASSWORD=

# Optional overrides of the active project (projects/<id>/project.json)
# APP_URL=https://qa.example.com
# TEST_BROWSERS=chromium,firefox,webkit
# TEST_ENV=QA
# TEST_IGNORE_HTTPS_ERRORS=1

# Supabase (free tier). Local files stay the source of truth; the server mirrors to Supabase.
# Project Settings -> API Keys (new-style keys; legacy anon/service_role retire in 2027). The secret key bypasses RLS: it stays in this .env, server-side
# only, and is never sent to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
# Only failure screenshots go up (no videos or traces). Screenshots of runs older than this many days
# are removed from Storage (free tier: 1 GB); the results stay, and local copies are never touched.
SUPABASE_EVIDENCE_RETENTION_DAYS=14
# The server mirrors every few minutes and after each run. TESTNOVA_SUPABASE=off stops it.
# Manual pass (first upload, or catch-up): npm run supabase:sync
# TESTNOVA_SUPABASE=off
